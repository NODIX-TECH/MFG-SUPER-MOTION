<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StreamGeometry x:Key="DisplayIcon">M 4,3 H 20 Q 22,3 22,5 V 15 Q 22,17 20,17 H 4 Q 2,17 2,15 V 5 Q 2,3 4,3 Z M 12,17 V 21 M 8,21 H 16</StreamGeometry>
    <StreamGeometry x:Key="VideoIcon">M 3,5 H 15 Q 17,5 17,7 V 17 Q 17,19 15,19 H 3 Q 1,19 1,17 V 7 Q 1,5 3,5 Z M 17,10 L 23,6.5 V 17.5 L 17,14</StreamGeometry>
    <StreamGeometry x:Key="ModsIcon">M 4,4 H 10 V 6.5 A 2,2 0 1 1 14,6.5 V 4 H 20 V 10 H 17.5 A 2,2 0 1 0 17.5,14 H 20 V 20 H 4 Z</StreamGeometry>
    <StreamGeometry x:Key="MoreClosedIcon">M 5,9 L 12,16 L 19,9</StreamGeometry>
    <StreamGeometry x:Key="MoreOpenIcon">M 5,15 L 12,8 L 19,15</StreamGeometry>
    <StreamGeometry x:Key="SupportIcon">M 12,21 C 12,21 3,15 3,8.5 C 3,5.5 5.4,3.5 8,3.5 C 9.7,3.5 11.2,4.4 12,5.8 C 12.8,4.4 14.3,3.5 16,3.5 C 18.6,3.5 21,5.5 21,8.5 C 21,15 12,21 12,21 Z</StreamGeometry>
    <StreamGeometry x:Key="SettingsIcon">M 9,2 H 15 L 15.7,5 L 17.5,6 L 20.5,5.1 L 23.5,10.3 L 21.2,12.4 V 14.4 L 23.5,16.5 L 20.5,21.7 L 17.5,20.8 L 15.7,21.8 L 15,24.8 H 9 L 8.3,21.8 L 6.5,20.8 L 3.5,21.7 L 0.5,16.5 L 2.8,14.4 V 12.4 L 0.5,10.3 L 3.5,5.1 L 6.5,6 L 8.3,5 Z M 16,13.4 A 4,4 0 1 1 8,13.4 A 4,4 0 1 1 16,13.4 Z</StreamGeometry>
    <StreamGeometry x:Key="HelpIcon">M 12,5 Q 7,2 2,4 V 21 Q 7,19 12,22 Q 17,19 22,21 V 4 Q 17,2 12,5 Z M 12,5 V 22</StreamGeometry>
    <ControlTheme x:Key="AdvancedButton" TargetType="ToggleButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="AdvancedBackground" Background="Transparent" MinHeight="40" Padding="10">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#AdvancedBackground"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#AdvancedBackground"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="RailButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><ControlTemplate><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="RoundThumb" TargetType="Thumb">
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
      <Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource InputBrush}" BorderThickness="3" CornerRadius="9" /></ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="Opacity" Value="0.9" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="ArmoSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="32" /><Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="10" />
      <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
      <Setter Property="TickFrequency" Value="1" /><Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent" MinHeight="32">
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal" IsDirectionReversed="False">
              <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource RailButton}" Background="{DynamicResource AccentBrush}" /></Track.DecreaseButton>
              <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource RailButton}" Background="{DynamicResource TrackBrush}" /></Track.IncreaseButton>
              <Thumb Name="PART_Thumb" Theme="{StaticResource RoundThumb}" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
      <Style Selector="^:focus-visible /template/ Thumb"><Setter Property="Opacity" Value="0.75" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="ArmoSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="40" /><Setter Property="Height" Value="20" />
      <Setter Property="UseLayoutRounding" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Rectangle Name="SwitchTrack" Margin="0.5" RadiusX="10" RadiusY="10" Fill="{DynamicResource SwitchTrackBrush}"
                       Stroke="{DynamicResource SwitchBorderBrush}" StrokeThickness="1" />
            <Ellipse Name="SwitchThumb" Width="12" Height="12" Fill="{DynamicResource KnobBrush}" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Rectangle Name="SwitchFocus" Margin="-3" RadiusX="13" RadiusY="13" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" IsVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Rectangle#SwitchTrack"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^:checked /template/ Ellipse#SwitchThumb"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Fill" Value="{DynamicResource ActiveSwitchKnobBrush}" /></Style>
      <Style Selector="^:pointerover /template/ Rectangle#SwitchTrack"><Setter Property="Stroke" Value="{DynamicResource TextBrush}" /></Style>
      <Style Selector="^:checked:pointerover /template/ Rectangle#SwitchTrack"><Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Stroke" Value="{DynamicResource AccentHoverBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Rectangle#SwitchFocus"><Setter Property="IsVisible" Value="True" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="UseLayoutRounding" Value="True" />
  </Style>
  <Style Selector="Border#WindowShell"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /></Style>
  <Style Selector="Border#Workspace"><Setter Property="Background" Value="{DynamicResource WorkspaceBrush}" /></Style>
  <Style Selector="Window.material Border#WindowShell"><Setter Property="Background" Value="{DynamicResource MaterialCanvasBrush}" /></Style>
  <Style Selector="Window.material Border#Workspace"><Setter Property="Background" Value="{DynamicResource MaterialWorkspaceBrush}" /></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.row-label"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="14" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
  <Style Selector="TextBlock.percentage"><Setter Property="FontSize" Value="14" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="20,18" /></Style>
  <Style Selector="Border.group"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,12,16,8" /></Style>
  <Style Selector="TextBlock.group-title"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Control.row-control"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  <Style Selector="Grid.row-control"><Setter Property="Width" Value="248" /></Style>
  <Style Selector="ComboBox"><Setter Property="Width" Value="200" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="MaxDropDownHeight" Value="300" /><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,5" /><Setter Property="FontSize" Value="14" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="TextBox.field"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,8" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox.field:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBox.field:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBox.crop"><Setter Property="Width" Value="64" /><Setter Property="MinWidth" Value="64" /><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="4,0" /><Setter Property="FontSize" Value="14" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="MaxLength" Value="4" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox.crop:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBox.crop:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <!-- Round 55: Adaptive's target, a number with arrows (as Lossless Scaling's), dressed as the boxes beside it. -->
  <Style Selector="NumericUpDown.target"><Setter Property="Width" Value="200" /><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="NumericUpDown.target:pointerover /template/ ButtonSpinner"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="NumericUpDown.target /template/ ButtonSpinner"><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,0" /><Setter Property="MinHeight" Value="34" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="NumericUpDown.target /template/ TextBox#PART_TextBox:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="NumericUpDown.target:focus-within /template/ ButtonSpinner"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="NumericUpDown.target /template/ RepeatButton"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" /></Style>
  <Style Selector="NumericUpDown.target /template/ RepeatButton:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBox.crop:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBox.crop:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="14,6" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="14" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,6" /></Style>
  <Style Selector="Button.nav /template/ ContentPresenter"><Setter Property="Background" Value="{TemplateBinding Background}" /></Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Style>
  <Style Selector="Button.utility"><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="Path.nav-icon"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="{DynamicResource TextBrush}" /><Setter Property="StrokeThickness" Value="1.8" /><Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FlowDirection" Value="LeftToRight" /></Style>
  <Style Selector="Button.icon"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.icon:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="Button.motion"><Setter Property="MinWidth" Value="148" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.motion /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.18" /></Transitions></Setter></Style>
  <Style Selector="Button.motion:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="Opacity" Value="0.6" /></Style>
  <Style Selector="Button.shortcut"><Setter Property="Width" Value="200" /><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" /></Style>
  <!-- The Support page's one large button, the Help page's links, and its entries: a name with what it does under it. -->
  <Style Selector="Button.support"><Setter Property="MinHeight" Value="76" /><Setter Property="Padding" Value="28,14" /><Setter Property="CornerRadius" Value="16" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.link"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="14,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="StackPanel.help-item"><Setter Property="Spacing" Value="2" /></Style>
  <Style Selector="Button.whatis"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="11" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,12,0" /></Style>

  <Style Selector="TextBlock.help-name"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.primary PathIcon"><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.motion.waiting"><Setter Property="Background" Value="{DynamicResource WaitingBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WaitingBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="Button.motion.waiting:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WaitingHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WaitingHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="Button.motion.waiting:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WaitingBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WaitingBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="Button.motion.running"><Setter Property="Background" Value="{DynamicResource RunningBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RunningBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="Button.motion.running:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource RunningHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RunningHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="Button.motion.running:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource RunningPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RunningPressedBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSignalBrush}" /></Style>
  <Style Selector="PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /></Style>
  <Style Selector="ListBox.profiles"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.profiles ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style Selector="ListBox.profiles ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Style>
  <Style Selector="ListBox.profiles ListBoxItem Border.profile-marker"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ListBox.profiles ListBoxItem:selected Border.profile-marker"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Border#Sidebar"><Setter Property="Width" Value="252" /><Setter Property="Padding" Value="16,20,16,14" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
  <Style Selector="StackPanel#ContentStack"><Setter Property="Margin" Value="48,32" /></Style>
  <Style Selector="Window.compact Border#Sidebar"><Setter Property="Width" Value="164" /><Setter Property="Padding" Value="10,16,10,12" /></Style>
  <Style Selector="Window.compact StackPanel#ContentStack"><Setter Property="Margin" Value="16,14" /></Style>
  <Style Selector="Window.compact TextBlock.heading"><Setter Property="FontSize" Value="20" /></Style>
  <Style Selector="Window.compact TextBlock.row-label"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="Window.compact Button.nav"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="Window.rtl Border#Sidebar"><Setter Property="BorderThickness" Value="1,0,0,0" /></Style>
  <Style Selector="Window.rtl Control.row-control"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
</Styles>
