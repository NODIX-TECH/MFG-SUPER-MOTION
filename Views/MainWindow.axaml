<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ARMO.Controls" xmlns:vm="using:ARMO.ViewModels" x:Class="ARMO.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="MFG SUPER MOTION" Icon="/Assets/armo.ico" Width="1254" Height="782" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowDecorations="Full" ExtendClientAreaToDecorationsHint="False"
        Background="Transparent" TransparencyBackgroundFallback="{DynamicResource CanvasBrush}"
        CanResize="True">
  <Border Name="WindowShell" ClipToBounds="True">
  <Grid>
    <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding !IsDialogOpen}">
      <Border Name="Sidebar" BorderBrush="{DynamicResource LineBrush}">
        <ScrollViewer Name="SidebarScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- 1.1.0: the side bar in the page's own look - its parts on cards as the page's are. -->
        <Grid RowDefinitions="Auto,12,*,12,Auto" Height="{Binding #SidebarScroll.Bounds.Height}" MinHeight="390">
          <Border Classes="side-card">
          <StackPanel Spacing="4">
            <Button Name="DisplayNav" Classes="nav utility" Classes.active="{Binding IsDisplay}" Command="{Binding DisplayCommand}" AutomationProperties.Name="Super Motion">
              <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource DisplayIcon}" /><TextBlock Grid.Column="1" Text="Super Motion" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Name="ConsoleNav" Classes="nav utility" Classes.active="{Binding IsConsole}" Command="{Binding ConsoleCommand}" IsVisible="{Binding IsWindows}" AutomationProperties.Name="Console Link">
              <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource ConsoleIcon}" /><TextBlock Grid.Column="1" Text="Console Link" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Name="SupportNav" Classes="nav utility" Classes.active="{Binding IsSupport}" Command="{Binding SupportCommand}" AutomationProperties.Name="{Binding Text.Support}">
              <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource SupportIcon}" /><TextBlock Grid.Column="1" Text="{Binding Text.Support}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Name="MoreNav" Classes="nav utility" Command="{Binding MoreCommand}" AutomationProperties.Name="{Binding Text.NavMore}">
              <Grid ColumnDefinitions="16,*">
                <Path Classes="nav-icon" Data="{StaticResource MoreClosedIcon}" IsVisible="{Binding !IsMoreOpen}" />
                <Path Classes="nav-icon" Data="{StaticResource MoreOpenIcon}" IsVisible="{Binding IsMoreOpen}" />
                <TextBlock Grid.Column="1" Text="{Binding Text.NavMore}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Name="MoreList" Spacing="4" IsVisible="{Binding IsMoreOpen}" Margin="14,0,0,0">
              <Button Name="VideoNav" Classes="nav utility" Classes.active="{Binding IsVideo}" Command="{Binding VideoCommand}" AutomationProperties.Name="Super Video">
                <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource VideoIcon}" /><TextBlock Grid.Column="1" Text="Super Video" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button Name="ModsNav" Classes="nav utility" Classes.active="{Binding IsMods}" Command="{Binding ModsCommand}" AutomationProperties.Name="App Mods">
                <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource ModsIcon}" /><TextBlock Grid.Column="1" Text="App Mods" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <StackPanel Name="ModNav" Spacing="4" />
            </StackPanel>
          </StackPanel>
          </Border>
          <Border Grid.Row="2" Classes="side-card">
          <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="muted" Text="{Binding Text.Profiles}" Margin="10,2,0,8" FontSize="13" FontWeight="SemiBold" />
          <ListBox Grid.Row="1" Classes="profiles" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Profiles}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItem">
                <Grid ColumnDefinitions="3,*" MinHeight="34">
                  <Border Classes="profile-marker" Width="3" Margin="0,8,0,8" CornerRadius="1" Background="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="14" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,50,50,38" Margin="2,12,2,0">
            <Button Classes="icon primary" Command="{Binding AddCommand}" Margin="0,0,12,0" ToolTip.Tip="{Binding Text.Add}" AutomationProperties.Name="{Binding Text.Add}"><PathIcon Data="M 11,2 L 13,2 L 13,11 L 22,11 L 22,13 L 13,13 L 13,22 L 11,22 L 11,13 L 2,13 L 2,11 L 11,11 Z" /></Button>
            <Button Grid.Column="1" Classes="icon" Command="{Binding ResetCommand}" Margin="0,0,12,0" ToolTip.Tip="{Binding Text.Reset}" AutomationProperties.Name="{Binding Text.Reset}"><PathIcon Data="M 12,4 A 8,8 0 1 1 4.6,9 L 6.5,9.7 A 6,6 0 1 0 12,6 L 12,9 L 7,5 L 12,1 Z" /></Button>
            <Button Grid.Column="2" Classes="icon" Command="{Binding RenameCommand}" Margin="0,0,12,0" ToolTip.Tip="{Binding Text.Rename}" AutomationProperties.Name="{Binding Text.Rename}"><PathIcon Data="M 16,2 L 22,8 L 8,22 L 2,22 L 2,16 Z M 16,5 L 5,17 L 5,19 L 7,19 L 19,8 Z" /></Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="{Binding Text.Delete}" AutomationProperties.Name="{Binding Text.Delete}"><PathIcon Data="M 8,2 L 16,2 L 16,4 L 8,4 Z M 3,6 L 21,6 L 21,8 L 19,8 L 18,22 L 6,22 L 5,8 L 3,8 Z M 7,8 L 8,20 L 16,20 L 17,8 Z M 10,10 L 11,10 L 11,18 L 10,18 Z M 13,10 L 14,10 L 14,18 L 13,18 Z" /></Button>
          </Grid>
          </Grid>
          </Border>
          <Border Grid.Row="4" Classes="side-card">
          <StackPanel Spacing="4">
            <Button Name="SettingsNav" Classes="nav utility" Classes.active="{Binding IsSettings}" Command="{Binding SettingsCommand}" AutomationProperties.Name="{Binding Text.Settings}">
              <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource SettingsIcon}" /><TextBlock Grid.Column="1" Text="{Binding Text.Settings}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Name="HelpNav" Classes="nav utility" Classes.active="{Binding IsHelp}" Command="{Binding HelpCommand}" AutomationProperties.Name="{Binding Text.Help}">
              <Grid ColumnDefinitions="16,*"><Path Classes="nav-icon" Data="{StaticResource HelpIcon}" /><TextBlock Grid.Column="1" Text="{Binding Text.Help}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
            </Button>
          </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </Border>
      <Border Name="Workspace" Grid.Column="1" />
      <ScrollViewer Name="ContentScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Name="ContentStack" Spacing="12">
          <Border Name="CleanCacheBanner" IsVisible="{Binding NeedsCacheClean}" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Text.CleanOldCache}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
              <Button Name="CleanCacheButton" Grid.Column="1" Classes="primary" Content="{Binding Text.CleanNow}" Command="{Binding CleanCacheCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text.CleanNow}" />
            </Grid>
          </Border>
          <Border Name="AppUpdateBanner" IsVisible="{Binding HasAppUpdate}" Background="{DynamicResource SelectionBrush}" CornerRadius="12" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding AppUpdateText}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
              <Button Grid.Column="1" Classes="primary" Content="{Binding Text.Download}" Command="{Binding OpenLinkCommand}" CommandParameter="app-releases" />
            </Grid>
          </Border>
          <Border IsVisible="{Binding HasSaveError}" Background="{DynamicResource SelectionBrush}" CornerRadius="12" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Text.SaveFailed}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
              <Button Grid.Column="1" Content="{Binding Text.Save}" Command="{Binding RetrySaveCommand}" />
            </Grid>
          </Border>
        <Panel>
          <!-- 1.1.0, the owner's sketch: the page's name and START at the top; Frame Generation and Upscaling side by side
               (under each other on a narrow window); Quick settings as chips; everything else under "More". Every binding
               and every named control of the page before is kept. -->
          <Grid Name="DisplayCards" IsVisible="{Binding IsDisplayOrConsole}" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <StackPanel Name="MotionHeader" IsVisible="{Binding IsDisplay}" Spacing="2" Margin="0,0,0,16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="page-title" Text="Super Motion" />
                <Button Name="StartMotionButton" Grid.Column="1" Classes="primary motion" Classes.waiting="{Binding IsMotionWaiting}" Classes.running="{Binding IsMotionRunning}" Content="{Binding MotionButtonText}"
                        Command="{Binding MotionCommand}" ToolTip.Tip="{Binding ShortcutLabel}" AutomationProperties.Name="{Binding MotionButtonText}" />
              </Grid>
              <TextBlock Name="MotionStatus" Classes="muted" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Margin="0,4,0,0" />
              <TextBlock Name="MotionNote" Classes="muted" Text="{Binding StatusNote}" IsVisible="{Binding HasStatusNote}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          <!-- Console Link (2026-11-16, the owner): a PlayStation 5 / 4 or an Xbox Series S / X on the home network, its picture
               shown here with frame generation on it. The page in the main page's way: its name, the platform, the consoles
               found and how this PC is joined to the network, and the stream's settings. -->
          <StackPanel Name="ConsolePage" Grid.Row="0" IsVisible="{Binding IsConsole}" Spacing="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
              <TextBlock Classes="page-title" Text="{Binding Text.ConsoleLink}" />
              <Button Name="ConsoleIntroWhatIs" Classes="whatis" Content="?" Margin="0" VerticalAlignment="Center" ToolTip.Tip="{Binding Text.ConsoleIntro}" AutomationProperties.Name="?" />
            </StackPanel>
            <ListBox Name="ConsolePlatformBar" Classes="segmented" ItemsSource="{Binding ConsoleLink.Platforms}" SelectedIndex="{Binding ConsoleLink.PlatformIndex, Mode=TwoWay}" HorizontalAlignment="Center" Width="360" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsoleLink}" />
            <ui:CardPair Name="ConsoleCards">
              <Border Name="ConsoleFoundCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="heading" Text="{Binding Text.ConsoleConsoles}" Margin="0,0,0,4" />
                  <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,10">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="card-label" Text="{Binding Text.ConsoleYourLink}" Margin="0" VerticalAlignment="Center" />
                        <Button Name="ConsoleLinkWhatIs" Classes="whatis" Content="?" Margin="0" ToolTip.Tip="{Binding ConsoleLink.LinkText}" AutomationProperties.Name="?" />
                      </StackPanel>
                      <TextBlock Name="ConsoleLinkText" Text="{Binding ConsoleLink.LinkShort}" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                  </Border>
                  <!-- Playing now: what, and Stop; the in-stream menu's keys. -->
                  <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="14,10" IsVisible="{Binding ConsoleLink.IsPlaying}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConsoleLink.PlayingText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Name="ConsolePlayingWhatIs" Classes="whatis" Content="?" Margin="0" ToolTip.Tip="{Binding ConsoleLink.MenuHelp}" AutomationProperties.Name="?" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="ConsoleBackButton" Classes="primary" Content="{Binding Text.ConsoleBack}" Command="{Binding ConsoleLink.BackCommand}" AutomationProperties.Name="{Binding Text.ConsoleBack}" />
                        <Button Content="{Binding Text.ConsoleStop}" Command="{Binding ConsoleLink.StopCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Spacing="10" IsVisible="{Binding ConsoleLink.IsPlayStation}">
                    <!-- The PlayStation account (a PS5's link needs its id): signed in once. -->
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="card-label" Text="{Binding Text.ConsoleAccount}" Margin="0" VerticalAlignment="Center" />
                          <Button Name="ConsoleAccountWhatIs" Classes="whatis" Content="?" Margin="0" ToolTip.Tip="{Binding Text.ConsoleSignInHelp}" AutomationProperties.Name="?" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding ConsoleLink.IsSignedOut}">
                          <Button Name="ConsoleSignInButton" Classes="primary" HorizontalAlignment="Center" Content="{Binding Text.ConsoleSignIn}" Command="{Binding ConsoleLink.SignInCommand}" AutomationProperties.Name="{Binding Text.ConsoleSignIn}" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="ConsolePasteBox" Classes="field" Text="{Binding ConsoleLink.Pasted, Mode=TwoWay}" PlaceholderText="{Binding Text.ConsolePasteHint}" FlowDirection="LeftToRight" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="{Binding Text.ConsoleSignInDone}" Command="{Binding ConsoleLink.FinishSignInCommand}" />
                          </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ConsoleLink.IsSignedIn}">
                          <TextBlock Text="{Binding Text.ConsoleSignedIn}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="{Binding Text.ConsoleSignOut}" Command="{Binding ConsoleLink.SignOutCommand}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding ConsoleLink.AccountNote}" IsVisible="{Binding ConsoleLink.HasAccountNote}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                      </StackPanel>
                    </Border>
                    <ui:SettingRow>
                      <TextBlock Classes="row-label" Text="{Binding Text.ConsolePasscode}" />
                      <TextBox Name="ConsolePasscodeBox" Classes="row-control field" Width="110" HorizontalContentAlignment="Center" PlaceholderText="••••" Text="{Binding ConsoleLink.Passcode, Mode=TwoWay}" MaxLength="4" PasswordChar="•" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsolePasscode}" />
                    </ui:SettingRow>
                    <ui:SettingRow>
                      <TextBlock Classes="row-label" Text="{Binding Text.ConsoleAddress}" />
                      <TextBox Name="ConsoleAddressBox" Classes="row-control field" Width="160" Text="{Binding ConsoleLink.ManualAddress, Mode=TwoWay}" PlaceholderText="192.168.1.20" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsoleAddress}" />
                    </ui:SettingRow>
                    <Button Name="ConsoleSearchButton" Classes="primary" HorizontalAlignment="Center" MinWidth="200" HorizontalContentAlignment="Center" Command="{Binding ConsoleLink.SearchCommand}" IsEnabled="{Binding ConsoleLink.CanSearch}" AutomationProperties.Name="{Binding Text.ConsoleSearch}">
                      <Panel>
                        <TextBlock Text="{Binding Text.ConsoleSearch}" IsVisible="{Binding !ConsoleLink.IsSearching}" />
                        <TextBlock Text="{Binding Text.ConsoleSearching}" IsVisible="{Binding ConsoleLink.IsSearching}" />
                      </Panel>
                    </Button>
                    <TextBlock Classes="muted" Text="{Binding Text.ConsoleNone}" IsVisible="{Binding ConsoleLink.NoneFound}" TextWrapping="Wrap" TextAlignment="Center" />
                    <ItemsControl Name="ConsoleList" ItemsSource="{Binding ConsoleLink.Consoles}" IsVisible="{Binding ConsoleLink.HasConsoles}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsoleEntry">
                          <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                              <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12" Foreground="White" FlowDirection="LeftToRight" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                                <TextBlock Classes="muted" Text="{Binding Address}" FlowDirection="LeftToRight" />
                              </StackPanel>
                              <Border Grid.Column="2" Classes="chipbox" Classes.on="{Binding IsReady}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateText}" Margin="12,6" FontSize="13" FontWeight="SemiBold" />
                              </Border>
                              <!-- (Not linked yet: its PIN and Link; linked: Play. A word under it while it works or when it failed.) -->
                              <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding IsNotLinked}">
                                <TextBox Classes="field" Text="{Binding Pin, Mode=TwoWay}" PlaceholderText="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.ConsolePin}" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.ConsolePinHelp}" MaxLength="8" FlowDirection="LeftToRight" IsEnabled="{Binding IsFree}" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Classes="primary" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.ConsoleLinkIt}" Command="{Binding LinkCommand}" IsEnabled="{Binding IsFree}" MinWidth="90" HorizontalContentAlignment="Center" />
                              </Grid>
                              <Button Grid.Row="1" Grid.ColumnSpan="3" Classes="primary" HorizontalAlignment="Center" MinWidth="160" HorizontalContentAlignment="Center" Margin="0,10,0,0"
                                      Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.ConsolePlay}" Command="{Binding PlayCommand}" IsVisible="{Binding IsLinked}" IsEnabled="{Binding IsFree}" />
                              <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="{Binding Text.ConsoleStreamMissing}" IsVisible="{Binding ConsoleLink.IsStreamMissing}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                  <!-- Xbox (2026-11-16): the Microsoft account signed in once in a small Edge window, the account's consoles from
                       Xbox's streaming service, Play. The stream plays in an Edge window; frame generation on it. -->
                  <StackPanel Spacing="10" IsVisible="{Binding ConsoleLink.IsXbox}">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="card-label" Text="{Binding Text.ConsoleXboxAccount}" Margin="0" VerticalAlignment="Center" />
                          <Button Name="ConsoleXboxWhatIs" Classes="whatis" Content="?" Margin="0" ToolTip.Tip="{Binding Text.ConsoleXboxSignInHelp}" AutomationProperties.Name="?" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding ConsoleLink.IsXboxSignedOut}">
                          <Button Name="XboxSignInButton" Classes="primary" HorizontalAlignment="Center" Content="{Binding Text.ConsoleXboxSignIn}" Command="{Binding ConsoleLink.XboxSignInCommand}" IsEnabled="{Binding ConsoleLink.CanXboxSignIn}" AutomationProperties.Name="{Binding Text.ConsoleXboxSignIn}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ConsoleLink.IsXboxSignedIn}">
                          <TextBlock Text="{Binding ConsoleLink.XboxSignedInText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="{Binding Text.ConsoleSignOut}" Command="{Binding ConsoleLink.XboxSignOutCommand}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding ConsoleLink.XboxNote}" IsVisible="{Binding ConsoleLink.HasXboxNote}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                      </StackPanel>
                    </Border>
                    <Button Name="XboxSearchButton" Classes="primary" HorizontalAlignment="Center" MinWidth="200" HorizontalContentAlignment="Center" Command="{Binding ConsoleLink.XboxSearchCommand}" IsEnabled="{Binding ConsoleLink.CanXboxSearch}" IsVisible="{Binding ConsoleLink.IsXboxSignedIn}" AutomationProperties.Name="{Binding Text.ConsoleXboxFind}">
                      <Panel>
                        <TextBlock Text="{Binding Text.ConsoleXboxFind}" IsVisible="{Binding !ConsoleLink.IsXboxSearching}" />
                        <TextBlock Text="{Binding Text.ConsoleXboxFinding}" IsVisible="{Binding ConsoleLink.IsXboxSearching}" />
                      </Panel>
                    </Button>
                    <TextBlock Classes="muted" Text="{Binding Text.ConsoleXboxNone}" IsVisible="{Binding ConsoleLink.XboxNoneFound}" TextWrapping="Wrap" TextAlignment="Center" />
                    <ItemsControl Name="XboxList" ItemsSource="{Binding ConsoleLink.Xboxes}" IsVisible="{Binding ConsoleLink.HasXboxes}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:XboxEntry">
                          <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                              <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12" Foreground="White" FlowDirection="LeftToRight" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                              <Border Grid.Column="2" Classes="chipbox" Classes.on="{Binding IsReady}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateText}" Margin="12,6" FontSize="13" FontWeight="SemiBold" />
                              </Border>
                              <Button Grid.Row="1" Grid.ColumnSpan="3" Classes="primary" HorizontalAlignment="Center" MinWidth="160" HorizontalContentAlignment="Center" Margin="0,10,0,0"
                                      Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.ConsolePlay}" Command="{Binding PlayCommand}" IsEnabled="{Binding IsFree}" />
                              <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="{Binding Text.ConsoleXboxEdgeMissing}" IsVisible="{Binding ConsoleLink.IsEdgeMissing}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Name="ConsoleStreamCard" Classes="card">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <TextBlock Classes="heading" Text="{Binding Text.ConsoleStream}" Margin="0" VerticalAlignment="Center" />
                    <Button Name="ConsoleStreamWhatIs" Classes="whatis" Content="?" Margin="0" ToolTip.Tip="{Binding Text.ConsoleCardsBelow}" AutomationProperties.Name="?" />
                  </StackPanel>
                  <TextBlock Classes="card-label" Text="{Binding Text.ConsoleResolution}" />
                  <ListBox Name="ConsoleResolutionBar" Classes="segmented" ItemsSource="{Binding ConsoleLink.Resolutions}" SelectedIndex="{Binding ConsoleLink.ResolutionIndex, Mode=TwoWay}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsoleResolution}" />
                  <TextBlock Classes="card-label" Text="{Binding Text.ConsoleFps}" Margin="0,4,0,0" IsVisible="{Binding ConsoleLink.IsPlayStation}" />
                  <ListBox Name="ConsoleFpsBar" IsVisible="{Binding ConsoleLink.IsPlayStation}" Classes="segmented" ItemsSource="{Binding ConsoleLink.FpsChoices}" SelectedIndex="{Binding ConsoleLink.FpsIndex, Mode=TwoWay}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsoleFps}" />
                  <TextBlock Classes="card-label" Text="{Binding Text.ConsoleCodec}" Margin="0,4,0,0" IsVisible="{Binding ConsoleLink.IsPlayStation}" />
                  <ListBox Name="ConsoleCodecBar" IsVisible="{Binding ConsoleLink.IsPlayStation}" Classes="segmented" ItemsSource="{Binding ConsoleLink.Codecs}" SelectedIndex="{Binding ConsoleLink.CodecIndex, Mode=TwoWay}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.ConsoleCodec}" />
                  <ui:SettingRow Margin="0,4,0,0">
                    <TextBlock Classes="row-label" Text="{Binding Text.ConsoleBitrate}" />
                    <ComboBox Name="ConsoleBitrateBox" Classes="row-control" ItemsSource="{Binding ConsoleLink.Bitrates}" SelectedIndex="{Binding ConsoleLink.BitrateIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.ConsoleBitrate}" />
                  </ui:SettingRow>
                  <TextBlock Classes="muted" Text="{Binding ConsoleLink.BitrateLabel}" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                  <Button Classes="primary" HorizontalAlignment="Center" Content="{Binding Text.ConsoleApply}" Command="{Binding ConsoleLink.ApplyQualityCommand}" IsVisible="{Binding ConsoleLink.QualityChanged}" />
                </StackPanel>
              </Border>
            </ui:CardPair>
          </StackPanel>
            <ui:CardPair Name="MainCards" Grid.Row="1">
              <Border Name="FrameGenerationCard" Classes="card">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Classes="heading" Text="{Binding Text.FrameGeneration}" Margin="0" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding FrameGenerationEnabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="{Binding GeneratorName}" AutomationProperties.Name="{Binding GeneratorName}" />
                  </Grid>
                  <ListBox Name="GeneratorBar" Classes="segmented" ItemsSource="{Binding Generators}" SelectedIndex="{Binding GeneratorIndex, Mode=TwoWay}" IsEnabled="{Binding !IsMotionActive}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.Generator}" />
                  <Grid ColumnDefinitions="*,10,*" Margin="0,6,0,0">
                    <ListBox Name="FrameModeBox" Classes="segmented" ItemsSource="{Binding FrameModes}" SelectedIndex="{Binding FrameModeIndex, Mode=TwoWay}" IsEnabled="{Binding FrameGenerationEnabled}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.Mode}" />
                    <!-- (1.1.0, the owner's last page round: the number sat higher than its name, and Custom opened a row of its own under the
                         field. Now the name and the number share one line, and Custom turns the number itself into one
                         typed or stepped with arrows, in the field - the drop-down's arrow stays uncovered beside it, so
                         the whole numbers are one click away.) -->
                    <Border Name="MultiplierField" Grid.Column="2" Classes="field-box">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="field-label" Text="{Binding Text.Multiplier}" IsVisible="{Binding IsFixed}" />
                        <TextBlock Classes="field-label" Text="{Binding Text.AdaptiveTarget}" IsVisible="{Binding IsAdaptive}" />
                        <Panel Grid.Column="1" IsVisible="{Binding IsFixed}" FlowDirection="LeftToRight">
                          <ComboBox Name="MultiplierBox" Classes="inline" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" IsEnabled="{Binding FrameGenerationEnabled}" AutomationProperties.Name="{Binding Text.Multiplier}" />
                          <Border Width="1" Margin="0,10,34,10" HorizontalAlignment="Right" Background="{DynamicResource LineBrush}" IsVisible="{Binding IsCustomMultiplier}" IsHitTestVisible="False" />
                          <NumericUpDown Name="CustomMultiplierBox" Classes="inline" Margin="0,0,40,0" Minimum="1.1" Maximum="6" Increment="0.1" FormatString="0.0" ClipValueToMinMax="False" AllowSpin="True" Value="{Binding CustomMultiplier, Mode=TwoWay}" IsVisible="{Binding IsCustomMultiplier}" IsEnabled="{Binding FrameGenerationEnabled}" ToolTip.Tip="{Binding Text.MultiplierHelp}" AutomationProperties.Name="{Binding Text.CustomMultiplier}" />
                        </Panel>
                        <NumericUpDown Name="AdaptiveFpsBox" Grid.Column="1" Classes="inline" Minimum="30" Maximum="1000" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="False" AllowSpin="True" Value="{Binding AdaptiveTarget, Mode=TwoWay}" IsVisible="{Binding IsAdaptive}" IsEnabled="{Binding FrameGenerationEnabled}" ToolTip.Tip="{Binding Text.AdaptiveHelp}" AutomationProperties.Name="{Binding Text.AdaptiveTarget}" FlowDirection="LeftToRight" />
                      </Grid>
                    </Border>
                  </Grid>
                  <ui:SettingRow>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Classes="row-label" Text="{Binding Text.Flow}" />
                      <Button Name="FlowGear" Classes="chip-icon" AutomationProperties.Name="FlowGear" ToolTip.Tip="{Binding Text.GameType}">
                        <Path Classes="chip-gear" Data="F0 M 9.60,4.16 L 10.00,1.18 L 14.00,1.18 L 14.40,4.16 L 15.85,4.76 L 18.23,2.93 L 21.07,5.77 L 19.24,8.15 L 19.84,9.60 L 22.82,10.00 L 22.82,14.00 L 19.84,14.40 L 19.24,15.85 L 21.07,18.23 L 18.23,21.07 L 15.85,19.24 L 14.40,19.84 L 14.00,22.82 L 10.00,22.82 L 9.60,19.84 L 8.15,19.24 L 5.77,21.07 L 2.93,18.23 L 4.76,15.85 L 4.16,14.40 L 1.18,14.00 L 1.18,10.00 L 4.16,9.60 L 4.76,8.15 L 2.93,5.77 L 5.77,2.93 L 8.15,4.76 Z M 8.60,12.00 A 3.40,3.40 0 1 1 15.40,12.00 A 3.40,3.40 0 1 1 8.60,12.00 Z" />
                        <Button.Flyout><Flyout Placement="Bottom" FlyoutPresenterClasses="settings">
                          <StackPanel Width="380" Spacing="4">
                            <ui:SettingRow>
                              <TextBlock Classes="row-label" Text="{Binding Text.GameType}" />
                              <ComboBox Classes="row-control" ItemsSource="{Binding GameTypes}" SelectedIndex="{Binding GameTypeIndex, Mode=TwoWay}" IsEnabled="{Binding IsMotionPrecisionOpen}" AutomationProperties.Name="{Binding Text.GameType}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                            </ui:SettingRow>
                          </StackPanel>
                        </Flyout></Button.Flyout>
                      </Button>
                    </StackPanel>
                    <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                      <Slider Theme="{StaticResource ArmoSlider}" Minimum="25" Maximum="100" TickFrequency="5" Value="{Binding Flow, Mode=TwoWay}" IsEnabled="{Binding IsFlowOpen}" AutomationProperties.Name="{Binding Text.Flow}" />
                      <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding FlowLabel}" />
                    </Grid>
                  </ui:SettingRow>
                  <!-- 1.1.0 testers' round: what belongs to the generator picked (DLSS MFG's preset; XeSS MFG's tensor cores is a chip
                       below), then the frame generation chips - "?" and a gear inside each that has more. SMT (was "Triangle Mesh")
                       is off to begin with now, for every generator. -->
                  <ui:SettingRow IsVisible="{Binding IsDlss}">
                    <TextBlock Classes="row-label" Text="{Binding Text.DlssPreset}" />
                    <ComboBox Classes="row-control" ItemsSource="{Binding DlssPresets}" SelectedIndex="{Binding DlssPresetIndex, Mode=TwoWay}" IsEnabled="{Binding !IsMotionActive}" AutomationProperties.Name="{Binding Text.DlssPreset}">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </ui:SettingRow>
                  <WrapPanel Name="FrameChips" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center" ItemsAlignment="Center">
                    <Border Classes="chipbox" Classes.on="{Binding TriangleMeshEnabled}" IsVisible="{Binding IsTriangleMeshShown}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="TriangleMeshSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.TriangleMesh}" IsChecked="{Binding TriangleMeshEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.TriangleMeshHelp}" AutomationProperties.Name="{Binding Text.TriangleMesh}" />
                        <Button Name="TriWhatIs" Classes="chip-icon" Content="?" AutomationProperties.Name="?" />
                        <Button Name="TriangleMeshSwitchGear" Classes="chip-icon" AutomationProperties.Name="TriangleMeshSwitchGear">
                          <Path Classes="chip-gear" Data="F0 M 9.60,4.16 L 10.00,1.18 L 14.00,1.18 L 14.40,4.16 L 15.85,4.76 L 18.23,2.93 L 21.07,5.77 L 19.24,8.15 L 19.84,9.60 L 22.82,10.00 L 22.82,14.00 L 19.84,14.40 L 19.24,15.85 L 21.07,18.23 L 18.23,21.07 L 15.85,19.24 L 14.40,19.84 L 14.00,22.82 L 10.00,22.82 L 9.60,19.84 L 8.15,19.24 L 5.77,21.07 L 2.93,18.23 L 4.76,15.85 L 4.16,14.40 L 1.18,14.00 L 1.18,10.00 L 4.16,9.60 L 4.76,8.15 L 2.93,5.77 L 5.77,2.93 L 8.15,4.76 Z M 8.60,12.00 A 3.40,3.40 0 1 1 15.40,12.00 A 3.40,3.40 0 1 1 8.60,12.00 Z" />
                          <Button.Flyout><Flyout Placement="Bottom" FlyoutPresenterClasses="settings">
                            <StackPanel Width="380" Spacing="4">
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriPitch}" ToolTip.Tip="{Binding Text.TriPitchHelp}" />
                                <ComboBox Name="TriPitchBox" Classes="row-control" ItemsSource="{Binding TriPitches}" SelectedIndex="{Binding TriPitchIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriPitch}" ToolTip.Tip="{Binding Text.TriPitchHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriRounds}" ToolTip.Tip="{Binding Text.TriRoundsHelp}" />
                                <ComboBox Name="TriRoundsBox" Classes="row-control" ItemsSource="{Binding TriRoundChoices}" SelectedIndex="{Binding TriRoundsIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriRounds}" ToolTip.Tip="{Binding Text.TriRoundsHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriFine}" ToolTip.Tip="{Binding Text.TriFineHelp}" />
                                <ComboBox Name="TriFineBox" Classes="row-control" ItemsSource="{Binding TriFineChoices}" SelectedIndex="{Binding TriFineIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriFine}" ToolTip.Tip="{Binding Text.TriFineHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriFull}" ToolTip.Tip="{Binding Text.TriFullHelp}" />
                                <ComboBox Name="TriFullBox" Classes="row-control" ItemsSource="{Binding TriFullChoices}" SelectedIndex="{Binding TriFullIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriFull}" ToolTip.Tip="{Binding Text.TriFullHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriHome}" ToolTip.Tip="{Binding Text.TriHomeHelp}" />
                                <ComboBox Name="TriHomeBox" Classes="row-control" ItemsSource="{Binding TriHomeChoices}" SelectedIndex="{Binding TriHomeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriHome}" ToolTip.Tip="{Binding Text.TriHomeHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriRange}" ToolTip.Tip="{Binding Text.TriRangeHelp}" />
                                <ComboBox Name="TriRangeBox" Classes="row-control" ItemsSource="{Binding TriRangeChoices}" SelectedIndex="{Binding TriRangeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriRange}" ToolTip.Tip="{Binding Text.TriRangeHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriExact}" ToolTip.Tip="{Binding Text.TriExactHelp}" />
                                <ComboBox Name="TriExactBox" Classes="row-control" ItemsSource="{Binding TriExactChoices}" SelectedIndex="{Binding TriExactIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriExact}" ToolTip.Tip="{Binding Text.TriExactHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                              <ui:SettingRow >
                                <TextBlock Classes="row-label" Text="{Binding Text.TriRelax}" ToolTip.Tip="{Binding Text.TriRelaxHelp}" />
                                <ComboBox Name="TriRelaxBox" Classes="row-control" ItemsSource="{Binding TriRelaxChoices}" SelectedIndex="{Binding TriRelaxIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.TriRelax}" ToolTip.Tip="{Binding Text.TriRelaxHelp}">
                                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                              </ui:SettingRow>
                            </StackPanel>
                          </Flyout></Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding XessTensorEnabled}" IsVisible="{Binding IsXessTensorShown}" IsEnabled="{Binding !IsMotionActive}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="XessTensorSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.XessTensor}" IsChecked="{Binding XessTensorEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.XessTensorHelp}" AutomationProperties.Name="{Binding Text.XessTensor}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding UltraSmoothEnabled}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="UltraSmoothSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.UltraSmooth}" IsChecked="{Binding UltraSmoothEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.UltraSmoothHelp}" AutomationProperties.Name="{Binding Text.UltraSmooth}" />
                        <Button Name="SmoothWhatIs" Classes="chip-icon" Content="?" AutomationProperties.Name="?" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding EvenPacingEnabled}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="EvenPacingSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.EvenPacing}" IsChecked="{Binding EvenPacingEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.EvenPacingHelp}" AutomationProperties.Name="{Binding Text.EvenPacing}" />
                        <Button Name="PacingWhatIs" Classes="chip-icon" Content="?" AutomationProperties.Name="?" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding LowLatencyEnabled}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="LowLatencySwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.LowLatency}" IsChecked="{Binding LowLatencyEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.LowLatency}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding AdaptiveLearningEnabled}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="AdaptiveLearningSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.AdaptiveLearning}" IsChecked="{Binding AdaptiveLearningEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.AdaptiveLearning}" />
                        <Button Name="AmlWhatIs" Classes="chip-icon" Content="?" AutomationProperties.Name="?" />
                        <Button Name="AdaptiveLearningSwitchGear" Classes="chip-icon" AutomationProperties.Name="AdaptiveLearningSwitchGear">
                          <Path Classes="chip-gear" Data="F0 M 9.60,4.16 L 10.00,1.18 L 14.00,1.18 L 14.40,4.16 L 15.85,4.76 L 18.23,2.93 L 21.07,5.77 L 19.24,8.15 L 19.84,9.60 L 22.82,10.00 L 22.82,14.00 L 19.84,14.40 L 19.24,15.85 L 21.07,18.23 L 18.23,21.07 L 15.85,19.24 L 14.40,19.84 L 14.00,22.82 L 10.00,22.82 L 9.60,19.84 L 8.15,19.24 L 5.77,21.07 L 2.93,18.23 L 4.76,15.85 L 4.16,14.40 L 1.18,14.00 L 1.18,10.00 L 4.16,9.60 L 4.76,8.15 L 2.93,5.77 L 5.77,2.93 L 8.15,4.76 Z M 8.60,12.00 A 3.40,3.40 0 1 1 15.40,12.00 A 3.40,3.40 0 1 1 8.60,12.00 Z" />
                          <Button.Flyout><Flyout Placement="Bottom" FlyoutPresenterClasses="settings">
                            <StackPanel Width="380" Spacing="4">
                              <ui:SettingRow>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <TextBlock Classes="row-label" Text="{Binding Text.AdaptiveFlow}" />
                                  <Button Name="AfsWhatIs" Classes="whatis" Content="?" AutomationProperties.Name="?" />
                                </StackPanel>
                                <Border Classes="row-control"><ToggleButton Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding AdaptiveFlowEnabled, Mode=TwoWay}" IsEnabled="{Binding IsAdaptiveFlowOpen}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.AdaptiveFlow}" /></Border>
                              </ui:SettingRow>
                              <ui:SettingRow IsVisible="{Binding IsWindows}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <TextBlock Classes="row-label" Text="{Binding Text.AmlGuide}" />
                                  <Button Name="GuideWhatIs" Classes="whatis" Content="?" AutomationProperties.Name="?" />
                                </StackPanel>
                                <Border Classes="row-control"><ToggleButton Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding AmlGuideEnabled, Mode=TwoWay}" IsEnabled="{Binding IsAdaptiveFlowOpen}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.AmlGuide}" /></Border>
                              </ui:SettingRow>
                            </StackPanel>
                          </Flyout></Button.Flyout>
                        </Button>
                        <TextBlock Name="LearningStatus" Classes="muted" Text="{Binding LearningStatus}" VerticalAlignment="Center" Margin="2,0,12,0" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <!-- (1.1.0, last page round: Linux's cards in the main page's look too - SMSR as a chip in the middle.) -->
              <Border Name="LinuxUpscalingCard" Classes="card" IsVisible="{Binding IsLinux}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="{Binding Text.Upscaling}" Margin="0,0,0,6" />
                  <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center">
                    <Border Classes="chipbox" Classes.on="{Binding SmsrEnabled}">
                      <ToggleButton Name="SmsrSwitch" Theme="{StaticResource ChipInner}" Content="SMSR 1.0" IsChecked="{Binding SmsrEnabled, Mode=TwoWay}" AutomationProperties.Name="SMSR 1.0" />
                    </Border>
                  </WrapPanel>
                  <ui:SettingRow>
                    <TextBlock Classes="row-label" Text="{Binding Text.SmsrStrength}" />
                    <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                      <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="200" Value="{Binding SmsrStrength, Mode=TwoWay}" IsEnabled="{Binding IsSmsrOn}" AutomationProperties.Name="{Binding Text.SmsrStrength}" />
                      <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding SmsrStrengthLabel}" />
                    </Grid>
                  </ui:SettingRow>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Text.LinuxSmsrHelp}" />
                </StackPanel>
              </Border>
              <Border Name="UpscalingCard" Classes="card" IsVisible="{Binding IsWindows}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="{Binding Text.Upscaling}" Margin="0,0,0,6" />
                  <ListBox Name="UpscalerTiles" Classes="tiles" ItemsSource="{Binding Upscalers}" SelectedIndex="{Binding UpscalerIndex, Mode=TwoWay}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Text.Upscaler}">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel Orientation="Horizontal" Margin="0,8,0,2" HorizontalAlignment="Center" ItemsAlignment="Center">
                    <Border Classes="chipbox" Classes.on="{Binding Dlss5DllReady}" IsVisible="{Binding IsDlss5On}">
                      <StackPanel Orientation="Horizontal">
                        <Button Name="Dlss5DllQuickButton" Theme="{StaticResource ChipButton}" Command="{Binding PickDlss5DllCommand}" ToolTip.Tip="{Binding Dlss5DllPath}" AutomationProperties.Name="{Binding Text.Dlss5Dll}">
                          <TextBlock Text="{Binding Dlss5DllLabel}" />
                        </Button>
                        <Button Name="Dlss5Gear" Classes="chip-icon" ToolTip.Tip="DLSS 5" AutomationProperties.Name="Dlss5Gear">
                          <Path Classes="chip-gear" Data="F0 M 9.60,4.16 L 10.00,1.18 L 14.00,1.18 L 14.40,4.16 L 15.85,4.76 L 18.23,2.93 L 21.07,5.77 L 19.24,8.15 L 19.84,9.60 L 22.82,10.00 L 22.82,14.00 L 19.84,14.40 L 19.24,15.85 L 21.07,18.23 L 18.23,21.07 L 15.85,19.24 L 14.40,19.84 L 14.00,22.82 L 10.00,22.82 L 9.60,19.84 L 8.15,19.24 L 5.77,21.07 L 2.93,18.23 L 4.76,15.85 L 4.16,14.40 L 1.18,14.00 L 1.18,10.00 L 4.16,9.60 L 4.76,8.15 L 2.93,5.77 L 5.77,2.93 L 8.15,4.76 Z M 8.60,12.00 A 3.40,3.40 0 1 1 15.40,12.00 A 3.40,3.40 0 1 1 8.60,12.00 Z" />
                          <Button.Flyout><Flyout Placement="Bottom" FlyoutPresenterClasses="settings">
                            <ScrollViewer Name="Dlss5FlyoutScroll" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                              <StackPanel Width="380" Spacing="4" Margin="0,0,12,0">
                                <ui:SettingRow>
                                  <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Dll}" />
                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Dlss5DllLabel}" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Dlss5DllPath}" />
                                  </StackPanel>
                                  <Button Name="Dlss5DllButton" Classes="row-control" Command="{Binding PickDlss5DllCommand}" AutomationProperties.Name="{Binding Text.Dlss5Dll}">
                                    <TextBlock Text="{Binding Text.Dlss5Browse}" />
                                  </Button>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Model}" />
                                  <ComboBox Classes="row-control" ItemsSource="{Binding Dlss5Models}" SelectedIndex="{Binding Dlss5ModelIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Model}">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Style}" />
                                  <ComboBox Classes="row-control" ItemsSource="{Binding Dlss5Styles}" SelectedIndex="{Binding Dlss5StyleIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Style}">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Passes}" />
                                  <ComboBox Classes="row-control" ItemsSource="{Binding Dlss5PassesChoices}" SelectedIndex="{Binding Dlss5PassesIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Passes}" FlowDirection="LeftToRight">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Scale}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="25" Maximum="100" Value="{Binding Dlss5Scale, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Scale}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5ScaleLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Intensity}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="300" Value="{Binding Dlss5Intensity, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Intensity}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5IntensityLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Tone}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="200" Value="{Binding Dlss5Tone, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Tone}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5ToneLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Structure}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="200" Value="{Binding Dlss5Structure, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Structure}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5StructureLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Skin}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="-100" Maximum="250" Value="{Binding Dlss5Skin, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Skin}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5SkinLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5KeepColors}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="100" Value="{Binding Dlss5KeepColors, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5KeepColors}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5KeepColorsLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5LowLight}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="100" Value="{Binding Dlss5LowLight, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5LowLight}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5LowLightLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Denoise}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="100" Value="{Binding Dlss5Denoise, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Denoise}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5DenoiseLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Edge}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="100" Value="{Binding Dlss5Edge, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Edge}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5EdgeLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Brightness}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="-100" Maximum="100" Value="{Binding Dlss5Brightness, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Brightness}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5BrightnessLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Contrast}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="-100" Maximum="100" Value="{Binding Dlss5Contrast, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Contrast}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5ContrastLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Saturation}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="-100" Maximum="100" Value="{Binding Dlss5Saturation, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Saturation}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5SaturationLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow>
                                  <TextBlock Classes="row-label" Text="{Binding Text.Dlss5Warmth}" />
                                  <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                                    <Slider Theme="{StaticResource ArmoSlider}" Minimum="-100" Maximum="100" Value="{Binding Dlss5Warmth, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Dlss5Warmth}" />
                                    <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding Dlss5WarmthLabel}" />
                                  </Grid>
                                </ui:SettingRow>
                                <Button Content="{Binding Text.Reset}" Command="{Binding Dlss5ResetCommand}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                              </StackPanel>
                            </ScrollViewer>
                          </Flyout></Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding StretchEnabled}">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="StretchSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.Stretch}" IsChecked="{Binding StretchEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Stretch}" />
                        <Button Name="StretchWhatIs" Classes="chip-icon" Content="?" AutomationProperties.Name="?" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                  <ui:SettingRow IsVisible="{Binding IsSmsrOn}">
                    <TextBlock Classes="row-label" Text="{Binding Text.SmsrStrength}" />
                    <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                      <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="200" Value="{Binding SmsrStrength, Mode=TwoWay}" IsEnabled="{Binding IsSmsrOn}" AutomationProperties.Name="{Binding Text.SmsrStrength}" />
                      <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding SmsrStrengthLabel}" />
                    </Grid>
                  </ui:SettingRow>
                  <ui:SettingRow IsVisible="{Binding IsSharpnessOpen}">
                    <TextBlock Classes="row-label" Text="{Binding Text.Sharpness}" />
                    <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                      <Slider Theme="{StaticResource ArmoSlider}" Value="{Binding Sharpness, Mode=TwoWay}" IsEnabled="{Binding IsSharpnessOpen}" AutomationProperties.Name="{Binding Text.Sharpness}" />
                      <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding SharpnessLabel}" />
                    </Grid>
                  </ui:SettingRow>
                  <ui:SettingRow IsVisible="{Binding IsOverSharpnessOpen}">
                    <TextBlock Classes="row-label" Text="{Binding Text.OverSharpness}" />
                    <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                      <Slider Theme="{StaticResource ArmoSlider}" Value="{Binding OverSharpness, Mode=TwoWay}" IsEnabled="{Binding IsOverSharpnessOpen}" AutomationProperties.Name="{Binding Text.OverSharpness}" />
                      <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding OverSharpnessLabel}" />
                    </Grid>
                  </ui:SettingRow>
                </StackPanel>
              </Border>
            </ui:CardPair>
            <Border Name="LinuxCard" Grid.Row="2" Classes="card" Margin="0,12,0,0" IsVisible="{Binding IsLinux}">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="{Binding Text.LinuxTitle}" />
                <TextBlock Classes="muted" Text="{Binding Text.LinuxIntro}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                  <TextBlock Name="LinuxLayerState" Text="{Binding LinuxLayerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Name="LinuxInstallButton" Grid.Column="1" Content="{Binding Text.LinuxInstall}" Command="{Binding LinuxInstallCommand}" Margin="8,0,0,0" />
                  <Button Name="LinuxRemoveButton" Grid.Column="2" Content="{Binding Text.LinuxUninstall}" Command="{Binding LinuxRemoveCommand}" IsVisible="{Binding IsLinuxInstalled}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding LinuxNote}" IsVisible="{Binding HasLinuxNote}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                <TextBlock Classes="row-label" Text="{Binding Text.LinuxLaunch}" Margin="0,8,0,0" />
                <TextBox Name="LinuxLaunchBox" Text="{Binding LinuxLaunchOption, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" />
                <TextBlock Classes="muted" Text="{Binding Text.LinuxLaunchHelp}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center" Margin="0,6,0,0">
                  <Border Classes="chipbox" Classes.on="{Binding LinuxEverywhere}">
                    <ToggleButton Name="LinuxEverywhereSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.LinuxEverywhere}" IsChecked="{Binding LinuxEverywhere, Mode=TwoWay}" ToolTip.Tip="{Binding Text.LinuxEverywhereHelp}" AutomationProperties.Name="{Binding Text.LinuxEverywhere}" />
                  </Border>
                </WrapPanel>
                <TextBlock Classes="muted" Text="{Binding Text.LinuxEverywhereHelp}" TextWrapping="Wrap" TextAlignment="Center" />
                <ui:SettingRow>
                  <TextBlock Classes="row-label" Text="{Binding Text.MotionSource}" />
                  <ComboBox Name="LinuxSearchBox" Classes="row-control" ItemsSource="{Binding MsmSearches}" SelectedIndex="{Binding MsmSearchIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.MotionSource}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </ui:SettingRow>
                <!-- (Round 101's "Triangle Mesh" row here is gone: SMT on Linux is the chip in Frame Generation, its gear's
                     numbers reaching the layer since round 114.) -->
                <Button Name="LinuxLogButton" Classes="link" HorizontalAlignment="Left" Content="{Binding Text.LinuxOpenLog}" Command="{Binding OpenLogsCommand}" />
              </StackPanel>
            </Border>
            <Border Name="QuickCard" Grid.Row="3" Classes="card" Margin="0,12,0,0">
              <StackPanel Spacing="6">
                <TextBlock Classes="heading" Text="{Binding Text.QuickSettings}" Margin="0,0,0,8" />
                <WrapPanel Name="QuickChips" Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center">
                  <Border Classes="chipbox" Classes.on="{Binding VrrEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="VrrSwitch" Theme="{StaticResource ChipInner}" Content="VRR" IsChecked="{Binding VrrEnabled, Mode=TwoWay}" AutomationProperties.Name="VRR" />
                    </StackPanel>
                  </Border>
                  <Border Classes="chipbox" Classes.on="{Binding HdrEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="HdrSwitch" Theme="{StaticResource ChipInner}" Content="HDR" IsChecked="{Binding HdrEnabled, Mode=TwoWay}" AutomationProperties.Name="HDR" />
                    </StackPanel>
                  </Border>
                  <Border Classes="chipbox" Classes.on="{Binding FpsCounterEnabled}" IsVisible="{Binding IsWindows}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="FpsCounterSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.FpsCounter}" IsChecked="{Binding FpsCounterEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.FpsCounter}" />
                      <Button Name="FpsCounterSwitchGear" Classes="chip-icon" AutomationProperties.Name="FpsCounterSwitchGear">
                        <Path Classes="chip-gear" Data="F0 M 9.60,4.16 L 10.00,1.18 L 14.00,1.18 L 14.40,4.16 L 15.85,4.76 L 18.23,2.93 L 21.07,5.77 L 19.24,8.15 L 19.84,9.60 L 22.82,10.00 L 22.82,14.00 L 19.84,14.40 L 19.24,15.85 L 21.07,18.23 L 18.23,21.07 L 15.85,19.24 L 14.40,19.84 L 14.00,22.82 L 10.00,22.82 L 9.60,19.84 L 8.15,19.24 L 5.77,21.07 L 2.93,18.23 L 4.76,15.85 L 4.16,14.40 L 1.18,14.00 L 1.18,10.00 L 4.16,9.60 L 4.76,8.15 L 2.93,5.77 L 5.77,2.93 L 8.15,4.76 Z M 8.60,12.00 A 3.40,3.40 0 1 1 15.40,12.00 A 3.40,3.40 0 1 1 8.60,12.00 Z" />
                        <Button.Flyout><Flyout Placement="Bottom" FlyoutPresenterClasses="settings">
                          <StackPanel Width="380" Spacing="4">
                            <ui:SettingRow>
                              <TextBlock Classes="row-label" Text="{Binding Text.FpsCounter}" />
                              <ComboBox Name="CounterModeBox" Classes="row-control" ItemsSource="{Binding CounterModes}" SelectedIndex="{Binding FpsCounterModeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.FpsCounter}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                            </ui:SettingRow>
                            <ui:SettingRow >
                              <TextBlock Classes="row-label" Text="{Binding Text.CounterSize}" />
                              <ComboBox Name="CounterSizeBox" Classes="row-control" ItemsSource="{Binding CounterSizes}" SelectedIndex="{Binding FpsCounterSizeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CounterSize}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                            </ui:SettingRow>
                          </StackPanel>
                        </Flyout></Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Border>
                  <Border Classes="chipbox" Classes.on="{Binding StillPixelsEnabled}" IsVisible="{Binding IsWindows}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="StillPixelsSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.StillPixels}" IsChecked="{Binding StillPixelsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.StillPixels}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="chipbox" Classes.on="{Binding LimitToScreenEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="ScreenLimitSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.ScreenLimit}" IsChecked="{Binding LimitToScreenEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.ScreenLimitHelp}" AutomationProperties.Name="{Binding Text.ScreenLimit}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="chipbox" Classes.on="{Binding MultiDisplayEnabled}" IsVisible="{Binding IsWindows}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Name="MultiDisplaySwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.MultiDisplay}" IsChecked="{Binding MultiDisplayEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.MultiDisplayHelp}" AutomationProperties.Name="{Binding Text.MultiDisplay}" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Name="AdvancedCard" Grid.Row="4" Margin="0,12,0,0" IsVisible="{Binding IsWindows}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
              <StackPanel>
                <ToggleButton Name="AdvancedToggle" Theme="{StaticResource AdvancedButton}" IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Advanced}">
                  <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Text.Advanced}" FontWeight="SemiBold" /><PathIcon Name="AdvancedArrow" Width="18" Height="12" Data="M 0,0 L 2,0 L 10,8 L 18,0 L 20,0 L 10,10 Z" /></StackPanel>
                </ToggleButton>
                <StackPanel Name="AdvancedRows" IsVisible="{Binding IsAdvancedOpen}" Margin="20,4,20,18" Spacing="12">
                  <ui:GroupFlow>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.GroupPacing}" />
                        <!-- Round 79: SMFG's frames on the screen's own refreshes (FIX PACING.md); round 88c: SMAI's too. -->
                        <ui:SettingRow IsVisible="{Binding IsOwnGenerator}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Classes="row-label" Text="{Binding Text.LockRefresh}" />
                            <Button Name="LockWhatIs" Classes="whatis" Content="?" AutomationProperties.Name="?" />
                          </StackPanel>
                          <Border Classes="row-control"><ToggleButton Name="LockRefreshSwitch" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding LockRefreshEnabled, Mode=TwoWay}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.LockRefresh}" /></Border>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.QueueTarget}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding QueueTargets}" SelectedIndex="{Binding QueueTargetIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.QueueTarget}" FlowDirection="LeftToRight" />
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.FrameLimit}" />
                          <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                            <Slider Theme="{StaticResource ArmoSlider}" Minimum="0" Maximum="360" Value="{Binding FrameLimit, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.FrameLimit}" />
                            <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding FrameLimitLabel}" />
                          </Grid>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.GameFps}" ToolTip.Tip="{Binding Text.GameFpsHelp}" />
                          <TextBox Name="GameFpsBox" Classes="crop" Width="120" HorizontalAlignment="Right" MaxLength="3" Text="{Binding GameFpsText, Mode=TwoWay}" PlaceholderText="{Binding Text.GameAuto}" ToolTip.Tip="{Binding Text.GameFpsHelp}" AutomationProperties.Name="{Binding Text.GameFps}" />
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.Display}" />
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.Bloom}" ToolTip.Tip="{Binding Text.BloomHelp}" />
                          <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                            <Slider Theme="{StaticResource ArmoSlider}" Value="{Binding Bloom, Mode=TwoWay}" ToolTip.Tip="{Binding Text.BloomHelp}" AutomationProperties.Name="{Binding Text.Bloom}" />
                            <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding BloomLabel}" />
                          </Grid>
                        </ui:SettingRow>
                        <ui:SettingRow IsVisible="{Binding IsBloomOn}">
                          <TextBlock Classes="row-label" Text="{Binding Text.BloomWide}" />
                          <Grid Classes="row-control" ColumnDefinitions="*,48" FlowDirection="LeftToRight">
                            <Slider Theme="{StaticResource ArmoSlider}" Value="{Binding BloomWide, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.BloomWide}" />
                            <TextBlock Grid.Column="1" Classes="percentage" Text="{Binding BloomWideLabel}" />
                          </Grid>
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.GroupMotion}" />
                        <ui:SettingRow IsVisible="{Binding IsDlss}">
                          <TextBlock Classes="row-label" Text="{Binding Text.MotionSource}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding MotionSources}" SelectedIndex="{Binding MotionSourceIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.MotionSource}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </ui:SettingRow>
                        <ui:SettingRow IsVisible="{Binding IsXess}">
                          <TextBlock Classes="row-label" Text="{Binding Text.MotionSource}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding XessMotionSources}" SelectedIndex="{Binding XessMotionSourceIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.MotionSource}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </ui:SettingRow>
                        <ui:SettingRow IsVisible="{Binding IsMsm}">
                          <TextBlock Classes="row-label" Text="{Binding Text.MotionSource}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding MsmSearches}" SelectedIndex="{Binding MsmSearchIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.MotionSource}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </ui:SettingRow>

                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.GroupCapture}" />
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.CaptureApi}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding CaptureApis}" SelectedIndex="{Binding CaptureApiIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CaptureApi}" FlowDirection="LeftToRight" />
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.WindowMode}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding WindowModes}" SelectedIndex="{Binding WindowModeIndex, Mode=TwoWay}" IsEnabled="{Binding !IsMotionActive}" AutomationProperties.Name="{Binding Text.WindowMode}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Classes="row-label" Text="{Binding Text.Countdown}" ToolTip.Tip="{Binding Text.CountdownHelp}" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding CountdownHint}" ToolTip.Tip="{Binding Text.CountdownHelp}" />
                          </StackPanel>
                          <NumericUpDown Name="CountdownBox" Classes="row-control target" Minimum="0" Maximum="120" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="False" AllowSpin="True" Value="{Binding CountdownSeconds, Mode=TwoWay}" IsEnabled="{Binding !IsMotionActive}" ToolTip.Tip="{Binding Text.CountdownHelp}" AutomationProperties.Name="{Binding Text.Countdown}" FlowDirection="LeftToRight" />
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.SpoutOutput}" />
                          <Border Classes="row-control"><ToggleButton Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding SpoutEnabled, Mode=TwoWay}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.SpoutOutput}" /></Border>
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.GroupGpu}" />
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.PreferredGpu}" />
                          <ComboBox Name="PreferredGpuBox" Classes="row-control" ItemsSource="{Binding GpuChoices}" SelectedItem="{Binding GpuName, Mode=TwoWay}" IsEnabled="{Binding !IsMotionActive}" AutomationProperties.Name="{Binding Text.PreferredGpu}" FlowDirection="LeftToRight" />
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.GpuPriority}" />
                          <ComboBox Classes="row-control" ItemsSource="{Binding GpuPriorities}" SelectedIndex="{Binding GpuPriorityIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.GpuPriority}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="group-title" Text="{Binding Text.CropInput}" ToolTip.Tip="{Binding Text.CropHelp}" />
                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" Margin="0,2,0,6" FlowDirection="LeftToRight" ToolTip.Tip="{Binding Text.CropHelp}">
                          <TextBox Name="CropTopBox" Grid.Column="1" Grid.Row="0" Classes="crop" Text="{Binding CropTopText, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CropTop}" />
                          <TextBox Name="CropLeftBox" Grid.Column="0" Grid.Row="1" Classes="crop" Text="{Binding CropLeftText, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CropLeft}" />
                          <PathIcon Grid.Column="1" Grid.Row="1" Width="34" Height="34" Margin="14" Opacity="0.7" Data="M 6,0 L 8,0 L 8,30 L 38,30 L 38,32 L 6,32 Z M 0,6 L 32,6 L 32,38 L 30,38 L 30,8 L 0,8 Z" />
                          <TextBox Name="CropRightBox" Grid.Column="2" Grid.Row="1" Classes="crop" Text="{Binding CropRightText, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CropRight}" />
                          <TextBox Name="CropBottomBox" Grid.Column="1" Grid.Row="2" Classes="crop" Text="{Binding CropBottomText, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.CropBottom}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.Cursor}" />
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.CursorClip}" />
                          <Border Classes="row-control"><ToggleButton Name="CursorClipSwitch" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding CursorClipEnabled, Mode=TwoWay}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.CursorClip}" /></Border>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.CursorSpeed}" ToolTip.Tip="{Binding Text.CursorScaledOnly}" />
                          <Border Classes="row-control"><ToggleButton Name="CursorSpeedSwitch" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding CursorSpeedEnabled, Mode=TwoWay}" HorizontalAlignment="Right" ToolTip.Tip="{Binding Text.CursorScaledOnly}" AutomationProperties.Name="{Binding Text.CursorSpeed}" /></Border>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.CursorHide}" />
                          <Border Classes="row-control"><ToggleButton Name="CursorHideSwitch" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding CursorHideEnabled, Mode=TwoWay}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.CursorHide}" /></Border>
                        </ui:SettingRow>
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.CursorScale}" ToolTip.Tip="{Binding Text.CursorScaledOnly}" />
                          <Border Classes="row-control"><ToggleButton Name="CursorScaleSwitch" Theme="{StaticResource ArmoSwitch}" IsChecked="{Binding CursorScaleEnabled, Mode=TwoWay}" HorizontalAlignment="Right" ToolTip.Tip="{Binding Text.CursorScaledOnly}" AutomationProperties.Name="{Binding Text.CursorScale}" /></Border>
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" IsVisible="{Binding IsWindows}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="group-title" Text="{Binding Text.Shortcut}" />
                        <ui:SettingRow>
                          <TextBlock Classes="row-label" Text="{Binding Text.FrameGeneration}" />
                          <Button Name="ShortcutButton" Classes="row-control shortcut" Content="{Binding ShortcutLabel}" Command="{Binding ShortcutCommand}" AutomationProperties.Name="{Binding Text.Shortcut}" FlowDirection="LeftToRight" />
                        </ui:SettingRow>
                      </StackPanel>
                    </Border>
                  </ui:GroupFlow>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel Name="ModSlotDisplay" Grid.Row="5" Spacing="12" Margin="0,12,0,0" IsVisible="False" />
          </Grid>
          <Border Name="VideoCard" Classes="card" IsVisible="{Binding IsVideo}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Classes="heading" Text="Super Video" Margin="0" />
              <TextBlock Text="{Binding Text.VideoIntro}" TextWrapping="Wrap" FontSize="14" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Name="VideoAddButton" Classes="primary" Content="{Binding Text.VideoAdd}" IsEnabled="{Binding !Video.IsRunning}" MinWidth="150" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Text.VideoAdd}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Name="VideoStartButton" Classes="primary" Content="{Binding Text.VideoStart}" Command="{Binding Video.StartCommand}" IsEnabled="{Binding Video.CanStart}" IsVisible="{Binding !Video.IsRunning}" MinWidth="110" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Text.VideoStart}" />
                  <Button Name="VideoStopButton" Content="{Binding Text.VideoStop}" Command="{Binding Video.StopCommand}" IsVisible="{Binding Video.IsRunning}" MinWidth="110" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Text.VideoStop}" />
                </StackPanel>
              </Grid>
              <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <TextBlock Classes="row-label" Text="{Binding Text.VideoOutput}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Name="VideoFolderText" Grid.Column="1" Text="{Binding Video.FolderLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" ToolTip.Tip="{Binding Video.FolderLabel}" />
                  <Button Name="VideoFolderButton" Grid.Column="2" Content="{Binding Text.VideoChooseFolder}" IsEnabled="{Binding !Video.IsRunning}" Margin="12,0,0,0" AutomationProperties.Name="{Binding Text.VideoChooseFolder}" />
                  <Button Grid.Column="3" Classes="icon" Command="{Binding Video.ClearFolderCommand}" IsVisible="{Binding Video.Folder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsEnabled="{Binding !Video.IsRunning}" Margin="8,0,0,0" Width="36" ToolTip.Tip="{Binding Text.VideoNextToEach}" AutomationProperties.Name="{Binding Text.VideoNextToEach}"><PathIcon Width="12" Height="12" Data="M 4,2 L 12,10 L 20,2 L 22,4 L 14,12 L 22,20 L 20,22 L 12,14 L 4,22 L 2,20 L 10,12 L 2,4 Z" /></Button>
                </Grid>
              </Border>
              <TextBlock Name="VideoNoteText" Text="{Binding Video.Note}" IsVisible="{Binding Video.HasNote}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Classes="muted" Text="{Binding Text.VideoEmpty}" IsVisible="{Binding Video.IsEmpty}" TextWrapping="Wrap" Margin="0,8" />
              <ItemsControl Name="VideoList" ItemsSource="{Binding Video.Items}" IsVisible="{Binding Video.HasItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VideoItem">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" ToolTip.Tip="{Binding Path}" />
                            <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.VideoShow}" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.RevealCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <Button Grid.Column="2" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.VideoRemove}" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.RemoveCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" IsVisible="{Binding IsWorking}" />
                        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
                          <StackPanel Spacing="4" Margin="0,0,12,6">
                            <TextBlock Classes="muted" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.VideoFrames}" />
                            <ComboBox Width="110" HorizontalAlignment="Left" ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.Frames}" SelectedIndex="{Binding FramesIndex, Mode=TwoWay}" FlowDirection="LeftToRight">
                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VideoChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Spacing="4" Margin="0,0,12,6">
                            <TextBlock Classes="muted" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.Generator}" />
                            <ComboBox Width="150" HorizontalAlignment="Left" ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.Techniques}" SelectedIndex="{Binding TechniqueIndex, Mode=TwoWay}" FlowDirection="LeftToRight">
                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VideoChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Spacing="4" Margin="0,0,12,6">
                            <TextBlock Classes="muted" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.VideoSize}" />
                            <ComboBox Width="170" HorizontalAlignment="Left" ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.Sizes}" SelectedIndex="{Binding SizeIndex, Mode=TwoWay}">
                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VideoChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Spacing="4" Margin="0,0,12,6">
                            <TextBlock Classes="muted" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.Upscaler}" />
                            <ComboBox Width="190" HorizontalAlignment="Left" ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.Upscalers}" SelectedIndex="{Binding UpscalerIndex, Mode=TwoWay}" FlowDirection="LeftToRight">
                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VideoChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Spacing="4" Margin="0,0,12,6">
                            <TextBlock Classes="muted" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.VideoCodec}" />
                            <ComboBox Width="150" HorizontalAlignment="Left" ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Video.Codecs}" SelectedIndex="{Binding CodecIndex, Mode=TwoWay}" FlowDirection="LeftToRight">
                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VideoChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding Text.VideoNote}" TextWrapping="Wrap" FontSize="12" />
              <StackPanel Name="ModSlotVideo" Spacing="12" IsVisible="False" />
            </StackPanel>
          </Border>
          <Border Name="ModsCard" Classes="card" IsVisible="{Binding IsMods}" VerticalAlignment="Top" Padding="28,40">
            <StackPanel Spacing="18" HorizontalAlignment="Center" MaxWidth="620">
              <Path Data="{StaticResource ModsIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
              <TextBlock Text="App Mods" Classes="heading" HorizontalAlignment="Center" Margin="0" FontSize="24" FlowDirection="LeftToRight" />
              <Border Background="{DynamicResource SelectionBrush}" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="12">
                  <TextBlock Text="Coming soon" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" />
                  <TextBlock Text="App Mods will let the community make mods for MFG SUPER MOTION - new features, tools and looks - without changing the app itself or publishing it again." FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" FlowDirection="LeftToRight" />
                  <TextBlock Classes="muted" Text="Install a mod, switch it on or off, and the app stays as it is." FontSize="13" TextWrapping="Wrap" TextAlignment="Center" FlowDirection="LeftToRight" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Name="SupportCard" Classes="card" IsVisible="{Binding IsSupport}" VerticalAlignment="Top" Padding="28,40">
            <StackPanel Spacing="22" HorizontalAlignment="Center" MaxWidth="620">
              <TextBlock Text="{Binding Text.Support}" Classes="heading" HorizontalAlignment="Center" Margin="0" FontSize="24" />
              <Button Name="SupportButton" Classes="primary support" Command="{Binding OpenLinkCommand}" CommandParameter="patreon" HorizontalAlignment="Stretch"
                      ToolTip.Tip="https://www.patreon.com/cw/NODIXTECH/shop" AutomationProperties.Name="{Binding Text.SupportButton}">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                  <Path Data="{StaticResource SupportIcon}" Fill="White" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Text.SupportButton}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Border Background="{DynamicResource SelectionBrush}" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding Text.SupportThanks}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Text.SupportText1}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                  <TextBlock Text="{Binding Text.SupportText2}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                </StackPanel>
              </Border>
              <StackPanel Name="ModSlotSupport" Spacing="12" IsVisible="False" />
            </StackPanel>
          </Border>
          <!-- 1.1.0, the owner's last page round: Settings in the main page's way - the page's name above, cards side by side (under each
               other on a narrow window), switches as chips in the middle. Every binding and named control is kept. -->
          <StackPanel Name="SettingsPage" IsVisible="{Binding IsSettings}" Spacing="12" VerticalAlignment="Top">
            <StackPanel Spacing="2" Margin="0,0,0,4">
              <TextBlock Classes="page-title" Text="{Binding Text.Settings}" />
              <TextBlock Classes="muted" Text="{Binding Text.SettingsDescription}" />
            </StackPanel>
            <ui:CardPair Name="SettingsCards">
              <Border Name="SettingsGeneralCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="heading" Text="{Binding Text.SettingsGeneral}" Margin="0,0,0,4" />
                  <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="card-label" Text="{Binding Text.VersionLabel}" />
                        <TextBlock Name="VersionText" Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Name="CheckUpdatesButton" Grid.Column="1" Content="{Binding Text.CheckUpdates}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsUpdateChecking}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="{Binding Text.CheckUpdates}" />
                    </Grid>
                  </Border>
                  <TextBlock Name="UpdateCheckText" Classes="muted" Text="{Binding UpdateCheckText}" IsVisible="{Binding UpdateCheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                  <ui:SettingRow><TextBlock Classes="row-label" Text="{Binding Text.Language}" /><ComboBox Name="LanguageBox" Classes="row-control" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Language}" FlowDirection="LeftToRight" /></ui:SettingRow>
                  <TextBlock Classes="card-label" Text="{Binding Text.Appearance}" Margin="0,6,0,0" />
                  <ListBox Name="ThemeBar" Classes="segmented" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Appearance}">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center" IsVisible="{Binding IsWindows}" Margin="0,4,0,0">
                    <Border Classes="chipbox" Classes.on="{Binding TransparencyEnabled}">
                      <ToggleButton Name="TransparencySwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.Transparency}" IsChecked="{Binding TransparencyEnabled, Mode=TwoWay}" ToolTip.Tip="{Binding Text.TransparencyDescription}" AutomationProperties.Name="{Binding Text.Transparency}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Classes="muted" Text="{Binding Text.TransparencyDescription}" IsVisible="{Binding IsWindows}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Name="SettingsStartupCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="heading" Text="{Binding Text.SettingsStartup}" Margin="0,0,0,4" />
                  <WrapPanel Name="StartupChips" Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center">
                    <Border Classes="chipbox" Classes.on="{Binding StartWithWindows}" IsVisible="{Binding IsWindows}">
                      <ToggleButton Name="StartWithWindowsSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.StartWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.StartWithWindows}" />
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding StartMinimized}">
                      <ToggleButton Name="StartMinimizedSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.StartMinimized}" IsChecked="{Binding StartMinimized, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.StartMinimized}" />
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding MinimizeToTray}">
                      <ToggleButton Name="MinimizeToTraySwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.MinimizeToTray}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.MinimizeToTray}" />
                    </Border>
                    <Border Classes="chipbox" Classes.on="{Binding EngineLog}" IsVisible="{Binding IsWindows}">
                      <ToggleButton Name="EngineLogSwitch" Theme="{StaticResource ChipInner}" Content="{Binding Text.EngineLog}" IsChecked="{Binding EngineLog, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.EngineLog}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Classes="muted" Text="{Binding Text.StartupFailed}" IsVisible="{Binding HasStartupError}" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Text.StartupDescription}" IsVisible="{Binding IsWindows}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </ui:CardPair>
            <Border Name="SettingsCacheCard" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="{Binding Text.LearningCache}" Margin="0" />
                <TextBlock Classes="card-label" Text="{Binding Text.AdaptiveLearning}" />
                <TextBlock Classes="muted" Text="{Binding Text.CacheEmpty}" IsVisible="{Binding NoLearnedGames}" />
                <ItemsControl Name="LearnedList" ItemsSource="{Binding LearnedGames}" IsVisible="{Binding HasLearnedGames}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LearnedItem">
                      <Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,8">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Game}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                            <TextBlock Classes="muted" Text="{Binding Status}" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Text.DeleteCache}" Command="{Binding DeleteCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Game}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Name="ModSlotSettings" Spacing="12" IsVisible="False" />
          </StackPanel>
          <!-- 1.1.0, the owner's last page round: Help in the main page's way - its name above, the message and the official places as cards
               side by side, the guide below as the More card is. (HelpOfficial's first two words stay the official places and
               the maker: ModHost keeps them so.) -->
          <StackPanel Name="HelpCard" IsVisible="{Binding IsHelp}" Spacing="12" VerticalAlignment="Top">
            <StackPanel Spacing="4" Margin="0,0,0,4">
              <TextBlock Classes="page-title" Text="{Binding Text.HelpTitle}" />
              <TextBlock Classes="muted" Text="{Binding Text.HelpDescription}" TextWrapping="Wrap" />
            </StackPanel>
            <ui:CardPair Name="HelpCards">
              <Border Name="FeedbackCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="heading" Text="{Binding Text.FeedbackTitle}" Margin="0,0,0,4" />
                  <TextBox Name="FeedbackBox" Classes="field" Text="{Binding FeedbackText, Mode=TwoWay}" PlaceholderText="{Binding Text.FeedbackHint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="200" MaxLength="1800" AutomationProperties.Name="{Binding Text.FeedbackTitle}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <CheckBox Name="FeedbackAttachBox" Content="{Binding Text.FeedbackAttach}" IsChecked="{Binding FeedbackAttach, Mode=TwoWay}" IsEnabled="{Binding CanAttachLog}" />
                      <TextBlock Classes="muted" Text="{Binding FeedbackLogNote}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding !CanAttachLog}" />
                    </StackPanel>
                    <Button Name="FeedbackSendButton" Grid.Column="1" Classes="primary" Content="{Binding Text.FeedbackSend}" Command="{Binding SendFeedbackCommand}" IsEnabled="{Binding CanSendFeedback}" MinWidth="110" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Text.FeedbackSend}" />
                  </Grid>
                  <TextBlock Name="FeedbackStatusText" Text="{Binding FeedbackStatus}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding FeedbackStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="muted" Text="{Binding Text.FeedbackWhat}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Border>
              <Border Name="HelpLinksCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="heading" Text="{Binding Text.HelpLinksTitle}" Margin="0,0,0,4" />
                  <Border Name="HelpOfficial" Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Text.HelpOfficial}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" Text="{Binding Text.HelpMaker}" />
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center" Margin="0,4,0,0">
                        <Button Classes="link" Content="GitHub" Command="{Binding OpenLinkCommand}" CommandParameter="github" ToolTip.Tip="https://github.com/NODIX-TECH/MFG-SUPER-MOTION" />
                        <Button Classes="link" Content="mfgsm.com" Command="{Binding OpenLinkCommand}" CommandParameter="site" ToolTip.Tip="https://www.mfgsm.com/" />
                        <Button Name="YoutubeButton" Classes="link primary" Content="YouTube · NODIX TECH" Command="{Binding OpenLinkCommand}" CommandParameter="youtube" ToolTip.Tip="https://www.youtube.com/@Nodix-Tech" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Button Name="HelpLogsButton" Classes="link" HorizontalAlignment="Center" Content="{Binding Text.OpenLogs}" Command="{Binding OpenLogsCommand}" AutomationProperties.Name="{Binding Text.OpenLogs}" />
                </StackPanel>
              </Border>
            </ui:CardPair>
              <Border Name="HelpGuideCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
              <StackPanel>
              <ToggleButton Name="HelpGuideToggle" Theme="{StaticResource AdvancedButton}" IsChecked="{Binding IsHelpGuideOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.HelpGuide}">
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Text.HelpGuide}" FontWeight="SemiBold" /><PathIcon Width="18" Height="12" Data="M 0,0 L 2,0 L 10,8 L 18,0 L 20,0 L 10,10 Z" /></StackPanel>
              </ToggleButton>
              <StackPanel Name="HelpGuide" IsVisible="{Binding IsHelpGuideOpen}" Spacing="14" Margin="20,4,20,18">
              <TextBlock Classes="group-title" Text="{Binding Text.HelpStartTitle}" />
              <TextBlock Text="{Binding Text.HelpStart}" TextWrapping="Wrap" FontSize="14" LineHeight="21" />

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpGeneratorsTitle}" />
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="DLSS MFG" FlowDirection="LeftToRight" /><TextBlock Classes="muted" Text="{Binding Text.HelpDlss}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="XeSS MFG" FlowDirection="LeftToRight" /><TextBlock Classes="muted" Text="{Binding Text.HelpXess}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="SMFG" FlowDirection="LeftToRight" /><TextBlock Classes="muted" Text="{Binding Text.HelpMsm}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="SMAI" FlowDirection="LeftToRight" /><TextBlock Classes="muted" Text="{Binding Text.HelpSmai}" /></StackPanel>

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpOptionsTitle}" />
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.Mode}" /><TextBlock Classes="muted" Text="{Binding Text.HelpMode}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.GameType}" /><TextBlock Classes="muted" Text="{Binding Text.HelpGameType}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.AdaptiveLearning}" /><TextBlock Classes="muted" Text="{Binding Text.HelpAml}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.AdaptiveFlow}" /><TextBlock Classes="muted" Text="{Binding Text.HelpAfs}" /></StackPanel>

              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.Upscaling}" /><TextBlock Classes="muted" Text="{Binding Text.HelpUpscaling}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.GroupPacing}" /><TextBlock Classes="muted" Text="{Binding Text.HelpPacing}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.EvenPacing}" /><TextBlock Classes="muted" Text="{Binding Text.EvenPacingHelp}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.Display}" /><TextBlock Classes="muted" Text="{Binding Text.HelpScreen}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.MotionSource}" /><TextBlock Classes="muted" Text="{Binding Text.HelpMotion}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.StillPixels}" /><TextBlock Classes="muted" Text="{Binding Text.HelpStill}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.GroupCapture}" /><TextBlock Classes="muted" Text="{Binding Text.HelpCapture}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.GroupGpu}" /><TextBlock Classes="muted" Text="{Binding Text.HelpGpu}" /></StackPanel>
              <StackPanel Classes="help-item"><TextBlock Classes="help-name" Text="{Binding Text.FpsCounter}" /><TextBlock Classes="muted" Text="{Binding Text.HelpCounter}" /></StackPanel>

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpObsTitle}" />
              <TextBlock Text="{Binding Text.HelpObs}" TextWrapping="Wrap" FontSize="14" LineHeight="21" />

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpTroubleTitle}" />
              <TextBlock Text="{Binding Text.HelpTrouble}" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
              <Button Name="OpenLogsButton" Classes="link" HorizontalAlignment="Left" Content="{Binding Text.OpenLogs}" Command="{Binding OpenLogsCommand}" />

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpKeysTitle}" />
              <TextBlock Text="{Binding Text.MotionHelp}" TextWrapping="Wrap" FontSize="14" />
              <TextBlock Text="{Binding Text.ProfileHelp}" TextWrapping="Wrap" FontSize="14" />
              <TextBlock Text="{Binding Text.SliderHelp}" TextWrapping="Wrap" FontSize="14" />
              <TextBlock Text="{Binding Text.KeyboardHelp}" TextWrapping="Wrap" FontSize="14" />

              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <TextBlock Classes="group-title" Text="{Binding Text.HelpLinksTitle}" />
              <WrapPanel Name="HelpLinks" Orientation="Horizontal">
                <Button Classes="link" Content="OBS Studio" Command="{Binding OpenLinkCommand}" CommandParameter="obs" ToolTip.Tip="https://obsproject.com/download" />
                <Button Classes="link" Content="OBS Spout2 plugin" Command="{Binding OpenLinkCommand}" CommandParameter="obs-spout" ToolTip.Tip="https://github.com/Off-World-Live/obs-spout2-plugin/releases" />
                <Button Classes="link" Content="Spout" Command="{Binding OpenLinkCommand}" CommandParameter="spout" ToolTip.Tip="https://spout.zeal.co/" />
                <Button Classes="link" Content="{Binding NvidiaDrivers}" Command="{Binding OpenLinkCommand}" CommandParameter="nvidia" ToolTip.Tip="https://www.nvidia.com/en-us/drivers/" />
                <Button Classes="link" Content="{Binding AmdDrivers}" Command="{Binding OpenLinkCommand}" CommandParameter="amd" ToolTip.Tip="https://www.amd.com/en/support/download/drivers.html" />
                <Button Classes="link" Content="{Binding IntelDrivers}" Command="{Binding OpenLinkCommand}" CommandParameter="intel" ToolTip.Tip="https://www.intel.com/content/www/us/en/download-center/home.html" />
                <Button Classes="link primary" Content="{Binding Text.SupportButton}" Command="{Binding OpenLinkCommand}" CommandParameter="patreon" ToolTip.Tip="https://www.patreon.com/cw/NODIXTECH/shop" />
              </WrapPanel>
              </StackPanel>
              </StackPanel>
              </Border>
              <StackPanel Name="ModSlotHelp" Spacing="12" IsVisible="False" />
          </StackPanel>
          <StackPanel Name="ModPages" Spacing="12" />
        </Panel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Background="#70000000" IsVisible="{Binding IsDialogOpen}">
      <Border Classes="card" MaxWidth="480" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel IsVisible="{Binding IsEditorOpen}" Spacing="10">
            <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" />
            <TextBox Name="ProfileNameBox" Text="{Binding DraftName, Mode=TwoWay}" PlaceholderText="{Binding Text.ProfileName}" MaxLength="40" MinHeight="36" AutomationProperties.Name="{Binding Text.ProfileName}" />
            <TextBlock Classes="muted" Text="{Binding Text.InvalidName}" IsVisible="{Binding IsNameInvalid}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{Binding Text.Cancel}" Command="{Binding CancelCommand}" /><Button Classes="primary" Content="{Binding Text.Save}" Command="{Binding SaveCommand}" IsDefault="True" /></StackPanel>
          </StackPanel>
          <StackPanel Name="EngineGate" IsVisible="{Binding IsGateOpen}" Spacing="14">
            <TextBlock Text="{Binding Text.EngineTitle}" FontSize="20" FontWeight="Bold" />
            <TextBlock Name="EngineGateText" Text="{Binding GateText}" TextWrapping="Wrap" FontSize="14" />
            <ProgressBar IsVisible="{Binding IsGateDownloading}" Minimum="0" Maximum="100" Value="{Binding GateProgress}" Height="8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Name="EngineSkip" Content="{Binding Text.Skip}" Command="{Binding GateSkipCommand}" IsVisible="{Binding CanGateSkip}" />
              <Button Name="EngineDownload" Classes="primary" Content="{Binding GateActionText}" Command="{Binding GateDownloadCommand}" IsVisible="{Binding CanGateDownload}" />
            </StackPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsDeleteOpen}" Spacing="12">
            <TextBlock Text="{Binding Text.DeleteQuestion}" FontSize="20" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding SelectedProfile.Name}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{Binding Text.Cancel}" Command="{Binding CancelCommand}" /><Button Classes="primary" Content="{Binding Text.Delete}" Command="{Binding ConfirmDeleteCommand}" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
  </Border>
</Window>

